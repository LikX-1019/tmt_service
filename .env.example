# 复制为 .env 后替换占位值，严禁提交任何真实账号或密钥。
COMPOSE_PROJECT_NAME=customer-service
TZ=Asia/Shanghai

MYSQL_PORT=3306
MYSQL_DATABASE=customer_service
MYSQL_USER=customer_service
MYSQL_PASSWORD=replace_with_mysql_password
MYSQL_ROOT_PASSWORD=replace_with_mysql_root_password

REDIS_PORT=6379
REDIS_PASSWORD=replace_with_redis_password

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=customer_service_minio
MINIO_ROOT_PASSWORD=replace_with_minio_password

MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091
ATTU_PORT=3000

# 应用基础配置
APP_ENV=local
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# 运行日志：logs/app-<时间>-<进程号>.log 和 logs/error-<时间>-<进程号>.log
LOG_DIR=logs

# 应用在宿主机运行时访问各数据服务所使用的地址
MYSQL_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_DB=0
MILVUS_HOST=127.0.0.1
MILVUS_COLLECTION=customer_service_knowledge
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_SECURE=false

# 大模型配置（默认通过 DeepSeek 的 OpenAI-compatible 地址访问）
LLM_PROVIDER=openai
LLM_API_KEY=replace_with_llm_api_key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 可选的场景模型 JSON 配置，例如：{"intent":"deepseek-chat"}
LLM_MODEL_ROUTES={}
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_STRUCTURED_OUTPUT_METHOD=function_calling

# 本地模型路径
EMBEDDING_MODEL_PATH=./model/bge-m3
RERANKER_MODEL_PATH=./model/bge-reranker
