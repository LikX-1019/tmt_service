# 复制为 .env 后替换占位值，严禁提交任何真实账号或密钥。
# 多 worktree 推荐使用 scripts/dev_compose.py 自动生成稳定且隔离的项目名。
# 如需手工固定项目名，可取消下一行注释并确保每个 worktree 使用不同值。
# COMPOSE_PROJECT_NAME=tmt-service-main
COMPOSE_DATA_DIR=./data/docker
TZ=Asia/Shanghai

# Compose 发布到宿主机的端口；应用在宿主机运行时 MYSQL_PORT 应与其一致。
MYSQL_HOST_PORT=3306
MYSQL_PORT=3306
MYSQL_DATABASE=customer_service
MYSQL_USER=customer_service
MYSQL_PASSWORD=replace_with_mysql_password
MYSQL_ROOT_PASSWORD=replace_with_mysql_root_password

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=customer_service_minio
MINIO_ROOT_PASSWORD=replace_with_minio_password

# Compose 发布到宿主机的端口；应用 MILVUS_PORT 应与其一致。
MILVUS_HOST_PORT=19530
MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091
ATTU_PORT=3000

# 独立商品资料库（仅绑定本机 127.0.0.1）
# Compose 发布到宿主机的端口；升级脚本使用 PRODUCT_POSTGRES_PORT 连接。
PRODUCT_POSTGRES_HOST=127.0.0.1
PRODUCT_POSTGRES_HOST_PORT=5432
PRODUCT_POSTGRES_PORT=5432
PRODUCT_POSTGRES_DB=product_catalog
PRODUCT_POSTGRES_USER=product_catalog
PRODUCT_POSTGRES_PASSWORD=replace_with_product_postgres_password

# 商品管理系统。0.0.0.0 表示允许局域网访问，请务必设置强密码。
COMMODITY_MANAGEMENT_BIND=0.0.0.0
COMMODITY_MANAGEMENT_PORT=8088
COMMODITY_ADMIN_USERNAME=admin
COMMODITY_ADMIN_PASSWORD=replace_with_at_least_12_characters
COMMODITY_SESSION_SECRET=replace_with_at_least_32_random_characters

# 应用基础配置
APP_ENV=local
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
# 运行日志：logs/app-<时间>-<进程号>.log 和 logs/error-<时间>-<进程号>.log
LOG_DIR=logs

# 应用在宿主机运行时访问各数据服务所使用的地址
MYSQL_HOST=127.0.0.1
MILVUS_HOST=127.0.0.1
MILVUS_COLLECTION=customer_service_knowledge_v1
MILVUS_SCHEMA_VERSION=1
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_SECURE=false

# 大模型配置（默认通过 DeepSeek 的 OpenAI-compatible 地址访问）
LLM_PROVIDER=openai
LLM_API_KEY=replace_with_llm_api_key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 可选的场景模型 JSON 配置，例如：{"intent":"deepseek-chat"}
LLM_MODEL_ROUTES={}
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
# 服务启动后在后台加载并缓存模型，避免首位用户承担依赖导入耗时
LLM_WARMUP_ON_STARTUP=true
LLM_STRUCTURED_OUTPUT_METHOD=function_calling

# 本地模型路径
EMBEDDING_MODEL_PATH=./model/bge-m3
RERANKER_MODEL_PATH=./model/bge-reranker

# QA 数据源：默认复用已导入的 MySQL cs_qa；excel 仅用于离线回退/开发
QA_DATA_SOURCE=mysql
QA_EXCEL_PATH=./data/qa/整理结果/智能客服标准QA整理.xlsx
QA_EXCEL_SHEET=标准QA

# QA / RAG 检索配置
EMBEDDING_PROVIDER=sentence_transformers
# 留空时使用 EMBEDDING_MODEL_PATH；也可填写 BAAI/bge-m3
EMBEDDING_MODEL=
EMBEDDING_VERSION=v1
EMBEDDING_MAX_CONCURRENCY=2
VECTOR_STORE=milvus
RAG_DENSE_TOP_K=20
RAG_BM25_TOP_K=20
RAG_FUSION_TOP_K=20
RAG_RERANK_TOP_K=5
RRF_K=60

RERANKER_PROVIDER=sentence_transformers
# 留空时使用 RERANKER_MODEL_PATH；也可填写 BAAI/bge-reranker-v2-m3
RERANKER_MODEL=
RERANKER_MAX_CONCURRENCY=1
# 需通过业务测试集调优；该值不是通用最佳阈值
RAG_SCORE_THRESHOLD=0.35

# 本地拼多多多店铺中台。每个店铺使用独立 Chrome 窗口和登录目录。
# 设为 false 时应用不创建 ShopRuntimeManager，也不启动 PDD/Chrome；控制台 API 返回 503。
CONSOLE_ENABLED=true
DEFAULT_SHOP_NAME=拼多多店铺
PDD_CHAT_URL=https://mms.pinduoduo.com/chat-merchant/index.html
# macOS 示例：/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Windows 示例：C:\Program Files\Google\Chrome\Application\chrome.exe
PDD_CHROME_EXECUTABLE=
PDD_CHROME_PROFILE_DIR=./data/runtime/pdd-chrome
# 新增店铺分别保存到该根目录；旧店仍使用上面的 legacy 登录目录。
PDD_CHROME_PROFILE_ROOT=./data/runtime/pdd-shops
PDD_MAX_ACTIVE_SHOPS=5
PDD_POLL_INTERVAL_SECONDS=1
# 拼多多消息进入中台后的回复倒计时，单位：秒
PDD_RESPONSE_TIMEOUT_SECONDS=160
# 聊天图片、表情、商品图与兜底截图的本地缓存。
MESSAGE_ASSET_DIR=./data/message-assets
MESSAGE_ASSET_MAX_BYTES=8388608

# 自动回复首次安装保持关闭；RAG 只有在离线校准文件达标后才允许自动发送。
AUTO_REPLY_DEBOUNCE_SECONDS=2
AUTO_REPLY_POLICY_VERSION=v1
AUTO_REPLY_CALIBRATION_PATH=./data/runtime/auto_reply_calibration.json
AUTO_REPLY_MIN_PRECISION=0.98
AUTO_REPLY_MIN_SAMPLES=100
# suggest_only / calibrated / immediate；immediate 仍受审核、风险、分数和差值门控。
AUTO_REPLY_RAG_MODE=calibrated
AUTO_REPLY_RAG_MIN_MARGIN=0.10
# 外部商品资料服务：GET {PRODUCT_API_BASE_URL}/products/{goods_id}。
# 返回 data（或顶层）中的 id、name、summary、selling_points、specifications、usage、
# suitable_for、warnings、after_sales_limits、updated_at；令牌仅保存在本地 .env。
PRODUCT_API_BASE_URL=http://127.0.0.1:8088
PRODUCT_API_BEARER_TOKEN=replace_with_at_least_24_random_characters
PRODUCT_API_TIMEOUT_SECONDS=8
PRODUCT_AUTO_REPLY_MIN_CONFIDENCE=0.95
MESSAGE_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90
