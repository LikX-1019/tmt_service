# Copy to .env and replace every placeholder. Never commit real credentials.
COMPOSE_PROJECT_NAME=customer-service
TZ=Asia/Shanghai

MYSQL_PORT=3306
MYSQL_DATABASE=customer_service
MYSQL_USER=customer_service
MYSQL_PASSWORD=replace_with_mysql_password
MYSQL_ROOT_PASSWORD=replace_with_mysql_root_password

REDIS_PORT=6379
REDIS_PASSWORD=replace_with_redis_password

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=customer_service_minio
MINIO_ROOT_PASSWORD=replace_with_minio_password

MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091
ATTU_PORT=3000

# Application
APP_ENV=local
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Service hosts as seen by an application running on the host machine
MYSQL_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_DB=0
MILVUS_HOST=127.0.0.1
MILVUS_COLLECTION=customer_service_knowledge
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_SECURE=false

# LLM (DeepSeek via its OpenAI-compatible endpoint by default)
LLM_PROVIDER=openai
LLM_API_KEY=replace_with_llm_api_key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# Optional JSON overrides, for example: {"intent":"deepseek-chat"}
LLM_MODEL_ROUTES={}
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_STRUCTURED_OUTPUT_METHOD=function_calling

# Local model paths
EMBEDDING_MODEL_PATH=./model/bge-m3
RERANKER_MODEL_PATH=./model/bge-reranker
